<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      i18n:domain="plone"
      metal:use-macro="context/main_template/macros/master">
<body>
<metal:main fill-slot="content" tal:define="portal_url context/portal_url">
  <section class="m-login">
    <metal:aside use-macro="context/@@{{namespace}}-macros/login_aside"></metal:aside>
    <div class="m-login__main">
      <div class="m-login__box">
        <h1 class="m-login__title">Accedi</h1>
        <p class="m-login__text">Inserisci le tue credenziali.</p>
        <div class="m-login__form">
          <div class="alert alert-danger pat-cookietrigger" style="display: none">
            I cookie non sono abilitati: abilitali per poter accedere.
          </div>
          <metal:form use-macro="context/@@ploneform-macros/titlelessform"/>
        </div>
        <ul class="m-login__links">
          <li><a tal:attributes="href string:${portal_url}/@@login-help">Hai dimenticato la password?</a></li>
          <li tal:condition="python:view.self_registration_enabled()"><a tal:attributes="href string:${portal_url}/@@register">Crea un account</a></li>
          <li><a tal:attributes="href portal_url"><i class="fa-regular fa-arrow-left" aria-hidden="true"></i> Torna al sito</a></li>
        </ul>
      </div>
    </div>
  </section>
</metal:main>
</body>
</html>
